{
  "$schema": "https://raw.githubusercontent.com/resnovas/smartcloud/main/schema.json",
  "labels": {
    "$schema": "https://raw.githubusercontent.com/resnovas/smartcloud/main/schema/labels.json",
    "abandoned": {
      "name": "Status - Abandoned",
      "color": "CFD3D7",
      "description": "This issue/pull request has been abandon"
    },
    "stale": {
      "name": "Status - Stale",
      "color": "CFD3D7",
      "description": "This issue has been automatically marked as stale because it has not had recent activity"
    },
    "chore": {
      "name": "Type - Chore",
      "color": "0075CA",
      "description": "Changes to the build process or auxiliary tools and libraries such as documentation generation"
    },
    "bug": {
      "name": "Type - Bug",
      "color": "0075CA",
      "description": "A possible bug"
    },
    "maintenance": {
      "name": "Type - Maintenance",
      "color": "0075CA",
      "description": "Changes to maintain the project"
    },
    "discussion": {
      "name": "Type - Discussion",
      "color": "0075CA",
      "description": "A conversation about something"
    },
    "documentation": {
      "name": "Type - Documentation",
      "color": "0075CA",
      "description": "Changes to the documentation"
    },
    "feature": {
      "name": "Type - Feature",
      "color": "0075CA",
      "description": "A new feature"
    },
    "enhancement": {
      "name": "Type - Enhancement",
      "color": "0075CA",
      "description": "Improving a feature"
    },
    "fix": {
      "name": "Type - Fix",
      "color": "0075CA",
      "description": "A bug fix"
    },
    "optimisation": {
      "name": "Type - Optimisation",
      "color": "0075CA",
      "description": "A code change that improves performance"
    },
    "refactor": {
      "name": "Type - Refactor",
      "color": "0075CA",
      "description": "A code change that neither fixes a bug nor adds a feature"
    },
    "revert": {
      "name": "Type - Revert",
      "color": "0075CA",
      "description": "Removes and discards a previous change as an error"
    },
    "deprecated": {
      "name": "Type - Deprecated",
      "color": "0075CA",
      "description": "Marks functionality which is no longer needed"
    },
    "removal": {
      "name": "Type - Removal",
      "color": "0075CA",
      "description": "Removes previous functionality which is no longer needed"
    },
    "style": {
      "name": "Type - Style",
      "color": "0075CA",
      "description": "Changes that do not affect the meaning of the code"
    },
    "dependences": {
      "name": "Type - Dependencies",
      "color": "0075CA",
      "description": "Changes that affect the dependencies"
    },
    "workflow": {
      "name": "Context - Workflows",
      "color": "f9cea2",
      "description": "Related to ./.github/workflows"
    },
    "releaseMastermind": {
      "name": "Context - Release Mastermind",
      "color": "f9cea2",
      "description": "Related to @resnovas/release-mastermind"
    },
    "labelMastermind": {
      "name": "Context - Label Mastermind",
      "color": "f9cea2",
      "description": "Related to @resnovas/label-mastermind"
    },
    "variableMastermind": {
      "name": "Context - Variable Mastermind",
      "color": "f9cea2",
      "description": "Related to @resnovas/variable-mastermind"
    },
    "condition": {
      "name": "Context - Conditions",
      "color": "f9cea2",
      "description": "Related to action conditions"
    },
    "api": {
      "name": "Context - API",
      "color": "f9cea2",
      "description": "Related to action API"
    },
    "contexts": {
      "name": "Context - Contexts",
      "color": "f9cea2",
      "description": "Related to action Contexts"
    },
    "util": {
      "name": "Context - Util",
      "color": "f9cea2",
      "description": "Related to action Utilities"
    },
    "installer": {
      "name": "Context - Installer",
      "color": "f9cea2",
      "description": "Related to action installer and automatic configuration tools"
    },
    "deps": {
      "name": "Context - Dependencies",
      "color": "f9cea2",
      "description": "Related to depenencies"
    },
    "depsDev": {
      "name": "Context - Dependencies",
      "color": "f9cea2",
      "description": "Related to developer dependencies"
    },
    "stageCompleted": {
      "name": "Stage - Completed",
      "color": "172875",
      "description": "Work has shipped through the full pipeline"
    },
    "stageDeploying": {
      "name": "Stage - Deploying",
      "color": "172875",
      "description": "Deploying to latest"
    },
    "stageDeveloping": {
      "name": "Stage - Developing",
      "color": "172875",
      "description": "Development is underway"
    },
    "devOpsRejected": {
      "name": "DevOps - Rejected",
      "color": "172875",
      "description": "DevOPS wont continue"
    },
    "devOpsReviewing": {
      "name": "DevOps - Reviewing",
      "color": "172875",
      "description": "DevOPS awaiting review"
    },
    "stageStaging": {
      "name": "Stage - Staging",
      "color": "172875",
      "description": "Deployed to the staging environment"
    },
    "stageTesting": {
      "name": "Stage - Testing",
      "color": "172875",
      "description": "Deployed to the testing environment"
    },
    "android": {
      "name": "Platform - Android",
      "color": "E0BE84"
    },
    "aws": {
      "name": "Platform - AWS",
      "color": "E0BE84"
    },
    "google": {
      "name": "Platform - Google Cloud",
      "color": "E0BE84"
    },
    "ios": {
      "name": "Platform - iOS",
      "color": "E0BE84"
    },
    "ubuntu": {
      "name": "Platform - Ubuntu",
      "color": "E0BE84"
    },
    "fedora": {
      "name": "Platform - Fedora",
      "color": "E0BE84"
    },
    "debian": {
      "name": "Platform - Debian",
      "color": "E0BE84"
    },
    "macos": {
      "name": "Platform - macOS",
      "color": "E0BE84"
    },
    "windows": {
      "name": "Platform - Windows",
      "color": "E0BE84"
    },
    "platformOther": {
      "name": "Platform - Other",
      "color": "E0BE84",
      "description": "A platform not covered by the other Platform labels"
    },
    "priorityCritical": {
      "name": "Priority - Critical",
      "color": "8de8b3",
      "description": "This bug affects more than 50% of users and should be patched before any new features are added"
    },
    "xs": {
      "name": "Size - XS",
      "color": "d4c5f9",
      "description": "Less than 10 lines changed"
    },
    "s": {
      "name": "Size - S",
      "color": "d4c5f9",
      "description": "More than 10 lines changed"
    },
    "m": {
      "name": "Size - M",
      "color": "d4c5f9",
      "description": "More than 30 lines changed"
    },
    "l": {
      "name": "Size - L",
      "color": "d4c5f9",
      "description": "More than 100 lines changed"
    },
    "xl": {
      "name": "Size - XL",
      "color": "d4c5f9",
      "description": "More than 500 lines changed"
    },
    "xxl": {
      "name": "Size - XXL",
      "color": "d4c5f9",
      "description": "More than 1000 lines changed"
    },
    "fixConfirmed": {
      "name": "Fix - Confirmed",
      "color": "D73A4A",
      "description": "This fix has been confirmed"
    },
    "bugConfirmed": {
      "name": "Bug - Confirmed",
      "color": "D73A4A",
      "description": "This bug has been confirmed"
    },
    "major": {
      "name": "Versioning - Major",
      "color": "e580c8",
      "description": "Major version increment due to backwards-incompatible changes"
    },
    "minor": {
      "name": "Versioning - Minor",
      "color": "e580c8",
      "description": "Minor version increment due to substantial new functionality or improvements"
    },
    "patch": {
      "name": "Versioning - Patch",
      "color": "e580c8",
      "description": "Patch version increment due to backwards-compatible bug fixes"
    },
    "prerelease": {
      "name": "Versioning - Prerelease",
      "color": "e580c8",
      "description": "Prerelease of the next version"
    },
    "build": {
      "name": "Versioning - Build",
      "color": "e580c8",
      "description": "A build to represent dependency updates and insignificant changes"
    },
    "breaking": {
      "name": "Versioning - BREAKING",
      "color": "e580c8",
      "description": "A breaking change"
    },
    "securityFix": {
      "name": "security fix",
      "color": "D1260F",
      "description": "A Security Fix"
    },
    "securityVulnerability": {
      "name": "security vulnerability",
      "color": "D1260F",
      "description": "A Security vulnerability"
    },
    "duplicate": {
      "name": "Duplicate",
      "color": "d4c5f9",
      "description": "A Duplicate of another issue/pull"
    },
    "help": {
      "name": "Help wanted",
      "color": "d4c5f9",
      "description": "Help is needed to continue"
    },
    "rebase": {
      "name": "Needs rebase",
      "color": "d4c5f9",
      "description": "This request needs to be rebased"
    },
    "wip": {
      "name": "Work in progress",
      "color": "d4c5f9",
      "description": "This pull request is a wip"
    },
    "moreInfo": {
      "name": "More information needed",
      "color": "d4c5f9",
      "description": "Requires more information before it can continue"
    },
    "firstIssue": {
      "name": "Good first issue",
      "color": "d4c5f9",
      "description": "A Good issue for first-time GitHub users"
    },
    "firstTimers": {
      "name": "First Timers",
      "color": "d4c5f9",
      "description": "A Good issue for first-time GitHub users"
    },
    "skipChangelog": {
      "name": "skip-changelog",
      "color": "d4c5f9",
      "description": "Skip the changelog"
    }
  },
  "runners": [
    {
      "$schema": "../../../schema/configs.json",
      "root": ".",
      "versioning": {
        "source": "milestones",
        "type": "SemVer"
      },
      "prereleaseName": "alpha",
      "sharedConfig": {
        "stale": {
          "staleLabel": "stale",
          "stale": {
            "days": 60,
            "comment": "This has been automatically marked as stale by the bot."
          },
          "abandoned": {
            "days": 30,
            "label": "abandoned",
            "comment": "This has been automatically marked as abandoned by the bot."
          }
        },
        "enforceConventions": {
          "condition": [
            {
              "requires": 1,
              "condition": "semanticEmoji"
            }
          ]
        },
        "labels": {
          "bug": {
            "requires": 1,
            "condition": [
              {
                "type": "titleMatches",
                "condition": "/^bug(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "descriptionMatches",
                "condition": "/(created|new|opened|made)( an| a)? bug/i"
              }
            ]
          },
          "chore": {
            "requires": 1,
            "condition": [
              {
                "type": "titleMatches",
                "condition": "/^chore(\\(.*\\))?(!)?:/i"
              }
            ]
          },
          "optimisation": {
            "requires": 2,
            "condition": [
              {
                "type": "titleMatches",
                "condition": "/^opt(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "titleMatches",
                "condition": "/^optimisation(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "titleMatches",
                "condition": "/^maint(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "titleMatches",
                "condition": "/^maintenance(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "descriptionMatches",
                "condition": "/^type:(,| |Style|Refactoring|Revert|Deprecated|Removal)*optimisation/im"
              }
            ]
          },
          "style": {
            "requires": 2,
            "condition": [
              {
                "type": "titleMatches",
                "condition": "/^style(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "titleMatches",
                "condition": "/^maint(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "titleMatches",
                "condition": "/^maintenance(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "descriptionMatches",
                "condition": "/^type:(,| |Refactoring|Optimisation|Revert|Deprecated|Removal)*style/im"
              }
            ]
          },
          "refactor": {
            "requires": 2,
            "condition": [
              {
                "type": "titleMatches",
                "condition": "/^ref(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "titleMatches",
                "condition": "/^refactor(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "titleMatches",
                "condition": "/^maint(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "titleMatches",
                "condition": "/^maintenance(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "descriptionMatches",
                "condition": "/^type:(,| |Style|Optimisation|Revert|Deprecated|Removal)*refactoring/im"
              }
            ]
          },
          "revert": {
            "requires": 2,
            "condition": [
              {
                "type": "titleMatches",
                "condition": "/^revert(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "titleMatches",
                "condition": "/^maint(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "titleMatches",
                "condition": "/^maintenance(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "descriptionMatches",
                "condition": "/^type:(,| |Style|Refactoring|Optimisation|Deprecated|Removal)*revert/im"
              }
            ]
          },
          "deprecated": {
            "requires": 2,
            "condition": [
              {
                "type": "titleMatches",
                "condition": "/^dep(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "titleMatches",
                "condition": "/^deprecated(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "titleMatches",
                "condition": "/^maint(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "titleMatches",
                "condition": "/^maintenance(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "descriptionMatches",
                "condition": "/^type:(,| |Style|Refactoring|Optimisation|Revert|Removal)*deprecated/im"
              }
            ]
          },
          "removal": {
            "requires": 2,
            "condition": [
              {
                "type": "titleMatches",
                "condition": "/^removal(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "titleMatches",
                "condition": "/^maint(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "titleMatches",
                "condition": "/^maintenance(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "descriptionMatches",
                "condition": "/^type:(,| |Style|Refactoring|Optimisation|Revert|Deprecated)*removal/im"
              }
            ]
          },
          "discussion": {
            "requires": 1,
            "condition": [
              {
                "type": "titleMatches",
                "condition": "/^discussion(\\(.*\\))?(!)?:/i"
              }
            ]
          },
          "documentation": {
            "requires": 1,
            "condition": [
              {
                "type": "titleMatches",
                "condition": "/^docs(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "titleMatches",
                "condition": "/^documentation(\\(.*\\))?(!)?:/i"
              }
            ]
          },
          "feature": {
            "requires": 1,
            "condition": [
              {
                "type": "titleMatches",
                "condition": "/^feat(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "titleMatches",
                "condition": "/^enhance(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "titleMatches",
                "condition": "/^feature(\\(.*\\))?(!)?:/i"
              },
              {
                "type": "titleMatches",
                "condition": "/^enhancement(\\(.*\\))?(!)?:/i"
              }
            ]
          },
          "fix": {
            "requires": 1,
            "condition": [
              {
                "type": "titleMatches",
                "condition": "/^fix(\\(.*\\))?(!)?:/i"
              }
            ]
          },
          "workflow": {
            "requires": 1,
            "condition": [
              {
                "type": "titleMatches",
                "condition": "/^.*\\((@videndum\\/)?workflow-mastermind\\)(!)?:/i"
              }
            ]
          },
          "releaseMastermind": {
            "requires": 1,
            "condition": [
              {
                "type": "descriptionMatches",
                "condition": "/^- package\\(s\\):.*(@videndum\\/)?release-mastermind.*/im"
              },
              {
                "type": "titleMatches",
                "condition": "/^.*\\((@videndum\\/)?release-mastermind\\)(!)?:/i"
              }
            ]
          },
          "labelMastermind": {
            "requires": 1,
            "condition": [
              {
                "type": "descriptionMatches",
                "condition": "/^- package\\(s\\):.*(@videndum\\/)?label-mastermind.*/im"
              },
              {
                "type": "titleMatches",
                "condition": "/^.*\\((@videndum\\/)?label-mastermind\\)(!)?:/i"
              }
            ]
          },
          "variableMastermind": {
            "requires": 1,
            "condition": [
              {
                "type": "descriptionMatches",
                "condition": "/^- package\\(s\\):.*(@videndum\\/)?variable-mastermind.*/im"
              },
              {
                "type": "titleMatches",
                "condition": "/^.*\\((@videndum\\/)?variable-mastermind\\)(!)?:/i"
              }
            ]
          },
          "condition": {
            "requires": 1,
            "condition": [
              {
                "type": "titleMatches",
                "condition": "/^.*\\(condition\\)(!)?:/i"
              }
            ]
          },
          "api": {
            "requires": 1,
            "condition": [
              {
                "type": "titleMatches",
                "condition": "/^.*\\(api\\)(!)?:/i"
              }
            ]
          },
          "contexts": {
            "requires": 1,
            "condition": [
              {
                "type": "titleMatches",
                "condition": "/^.*\\(contexts\\)(!)?:/i"
              }
            ]
          },
          "util": {
            "requires": 1,
            "condition": [
              {
                "type": "titleMatches",
                "condition": "/^.*\\(util\\)(!)?:/i"
              }
            ]
          },
          "installer": {
            "requires": 1,
            "condition": [
              {
                "type": "titleMatches",
                "condition": "/^.*\\(installer\\)(!)?:/i"
              }
            ]
          },
          "deps": {
            "requires": 1,
            "condition": [
              {
                "type": "titleMatches",
                "condition": "/^.*\\(deps\\)(!)?:/i"
              }
            ]
          },
          "depsDev": {
            "requires": 1,
            "condition": [
              {
                "type": "titleMatches",
                "condition": "/^.*\\(deps-dev\\)(!)?:/i"
              }
            ]
          },
          "priorityCritical": {
            "requires": 1,
            "condition": [
              {
                "type": "titleMatches",
                "condition": "!:.*(critical|urgent)?|!?:.*(critical|urgent)"
              }
            ]
          }
        }
      },
      "pr": {
        "manageRelease": {
          "version": "bump",
          "labels": {
            "prerelease": "Versioning - Prerelease",
            "build": "Versioning - Build",
            "patch": "Versioning - Patch",
            "minor": "Versioning - Minor",
            "major": "Versioning - Major",
            "breaking": "Versioning - Breaking"
          },
          "createTag": true,
          "createRelease": true,
          "createMilestone": {},
          "createPackages": "npm publish",
          "createChangelog": {
            "includeIssues": true,
            "sections": [
              {
                "title": "Features Effectuated",
                "PRlabels": [
                  "Type - Feature"
                ],
                "issueLabels": [],
                "includeCommitter": true,
                "linkPR": true
              },
              {
                "title": "Bugs Squashed",
                "PRlabels": [
                  "Type - Fix"
                ],
                "issueLabels": [],
                "includeCommitter": true,
                "linkPR": true
              },
              {
                "title": "Maintenance & Dusting",
                "PRlabels": [
                  "Type - Maintenance",
                  "Type - Style",
                  "Type - Documentation",
                  "Type - Enhancement",
                  "Type - Optimisation",
                  "Type - Refactor"
                ],
                "issueLabels": [],
                "includeCommitter": true,
                "linkPR": true
              },
              {
                "title": "Abolishment",
                "PRlabels": [
                  "Type - Revert",
                  "Type - deprecated",
                  "Type - Removal"
                ],
                "issueLabels": [],
                "includeCommitter": true,
                "linkPR": true
              },
              {
                "title": "Confession Time",
                "PRlabels": [],
                "issueLabels": [
                  "Bug - Confirmed"
                ],
                "includeCommitter": true,
                "linkPR": true
              }
            ]
          },
          "condition": {}
        },
        "automaticApprove": {
          "condition": [
            {
              "requires": 1,
              "condition": [
                {
                  "type": "creatorMatches",
                  "condition": "/^dependabot/i"
                }
              ]
            }
          ]
        },
        "requestApprovals": {
          "all": {
            "reviewers": [
              "tgtgamer"
            ],
            "requires": 1,
            "condition": [
              {
                "type": "$not",
                "requires": 1,
                "condition": [
                  {
                    "type": "creatorMatches",
                    "condition": "/^dependabot/i"
                  }
                ]
              }
            ]
          }
        },
        "duplicateHotfix": {},
        "createMilestone": {},
        "labels": {
          "xs": {
            "requires": 1,
            "condition": [
              {
                "type": "changesSize",
                "min": 0,
                "max": 10
              }
            ]
          },
          "s": {
            "requires": 1,
            "condition": [
              {
                "type": "changesSize",
                "min": 10,
                "max": 30
              }
            ]
          },
          "m": {
            "requires": 1,
            "condition": [
              {
                "type": "changesSize",
                "min": 40,
                "max": 100
              }
            ]
          },
          "l": {
            "requires": 1,
            "condition": [
              {
                "type": "changesSize",
                "min": 100,
                "max": 500
              }
            ]
          },
          "xl": {
            "requires": 1,
            "condition": [
              {
                "type": "changesSize",
                "min": 500,
                "max": 1000
              }
            ]
          },
          "xxl": {
            "requires": 1,
            "condition": [
              {
                "type": "changesSize",
                "min": 1000
              }
            ]
          },
          "fixConfirmed": {
            "requires": 6,
            "condition": [
              {
                "type": "descriptionMatches",
                "condition": "/^- \\[x\\] fix Confirmed by ((@.*& .*){4,}|(@.*& )*@(tgtgamer|videndum\\/.*))/im"
              },
              {
                "type": "descriptionMatches",
                "condition": "/^- \\[x\\] have fixed on a clean installation/im"
              },
              {
                "type": "descriptionMatches",
                "condition": "/^- \\[x\\] have fixed on a stable build/im"
              },
              {
                "type": "descriptionMatches",
                "condition": "/^- \\[x\\] have fixed on a development build/im"
              },
              {
                "type": "descriptionMatches",
                "condition": "/^- \\[x\\] have included logs or screenshots/im"
              },
