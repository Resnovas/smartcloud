# Dependencies
node_modules

# Build output. The action bundle in dist/ is committed only by the release
# workflow, into a release commit that only its v* tag points at.
packages/*/dist
apps/*/dist
tests/*/dist
out-tsc
coverage
test-output
tmp

# Nx
.nx/cache
.nx/workspace-data
.nx/polygraph
.nx/self-healing
.nx/migrate-runs
vitest.config.*.timestamp*

# Editors and systems
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.idea
.DS_Store
Thumbs.db
*.log
.env
.env.*

# The action bundle, committed only in release commits
/dist
apps/cli/release
