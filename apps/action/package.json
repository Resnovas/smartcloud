{
  "name": "@resnovas/action",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The smartcloud GitHub Action: runs every configured feature for the triggering event and reports the result.",
  "license": "SEE LICENSE IN LICENSE",
  "exports": {
    ".": {
      "@resnovas/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "nx": {
    "tags": [
      "type_platform",
      "layer_backend"
    ],
    "targets": {
      "bundle": {
        "dependsOn": ["build"],
        "command": "esbuild apps/action/dist/main.js --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --legal-comments=none",
        "outputs": ["{workspaceRoot}/dist/index.js"]
      }
    }
  },
  "dependencies": {
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^0.108.2",
    "@resnovas/config": "workspace:*",
    "@resnovas/engine": "workspace:*",
    "@resnovas/feature.commits": "workspace:*",
    "@resnovas/feature.conventions": "workspace:*",
    "@resnovas/feature.disclosure": "workspace:*",
    "@resnovas/feature.labels": "workspace:*",
    "@resnovas/feature.reviews": "workspace:*",
    "@resnovas/feature.settings": "workspace:*",
    "@resnovas/feature.stale": "workspace:*",
    "@resnovas/feature.sync": "workspace:*",
    "@resnovas/integrations.github": "workspace:*",
    "@resnovas/reporting": "workspace:*",
    "effect": "catalog:",
    "tslib": "^2.8.1"
  }
}
