#!/usr/bin/env sh
# Synced from Resnovas/.github templates/tools/graphify/graphify.
# Generated navigation is checkout-local, never staged or committed.
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd -P)
GRAPHIFY_SPEC='graphifyy[mcp,ollama,sql]'
GRAPHIFY_PYTHON='3.13'
GRAPHIFY_MODEL='qwen2.5-coder:7b'
GRAPHIFY_TOKEN_BUDGET='1200'
if [ -f "$SCRIPT_DIR/graphify.local.env" ]; then
    . "$SCRIPT_DIR/graphify.local.env"
fi
STATE_DIR="${GRAPHIFY_STATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/resnovas-graphify}"
TOOL_DIR="$STATE_DIR/tools"
BIN_DIR="$STATE_DIR/bin"
GRAPHIFY_HOME="$STATE_DIR/home"
VENV_PYTHON="$TOOL_DIR/graphifyy/bin/python"
GRAPH_JSON="$REPO_ROOT/graphify-out/graph.json"

die() { printf 'graphify: %s\n' "$1" >&2; exit 1; }
require_setup() {
    [ -x "$VENV_PYTHON" ] || die 'not installed; run sh tools/graphify/graphify setup'
}

# One environment boundary for CLI, generation and MCP. No automatic upgrade
# or model download on a query, checkout, pull or commit. Setup is explicit.
safe_run() {
    env -u OPENAI_API_KEY -u ANTHROPIC_API_KEY -u GEMINI_API_KEY \
        -u GOOGLE_API_KEY -u DEEPSEEK_API_KEY -u MOONSHOT_API_KEY \
        -u KIMI_API_KEY -u AWS_ACCESS_KEY_ID -u AWS_SECRET_ACCESS_KEY \
        -u AWS_SESSION_TOKEN -u GRAPHIFY_OUT \
        HOME="$GRAPHIFY_HOME" GRAPHIFY_QUERY_LOG_DISABLE=1 PYTHONHASHSEED=0 \
        "$@"
}
local_graph() {
    require_setup
    safe_run "$VENV_PYTHON" "$SCRIPT_DIR/local.py" "$@"
}

command=${1:-help}
[ "$#" -gt 0 ] && shift
case "$command" in
    setup)
        hooks=yes
        for arg in "$@"; do
            case "$arg" in --no-hooks) hooks=no ;; *) die "unknown setup option: $arg" ;; esac
        done
        if [ ! -x "$VENV_PYTHON" ]; then
            command -v uv >/dev/null 2>&1 || die 'uv is required to install Graphify'
            mkdir -p "$TOOL_DIR" "$BIN_DIR" "$GRAPHIFY_HOME"
            UV_TOOL_DIR="$TOOL_DIR" UV_TOOL_BIN_DIR="$BIN_DIR" \
                uv tool install --python "$GRAPHIFY_PYTHON" "$GRAPHIFY_SPEC" >&2
        fi
        if [ "$hooks" = yes ]; then local_graph hooks; fi
        local_graph update
        ;;
    update | check | snapshot | hook) local_graph "$command" "$@" ;;
    query | explain | path | affected)
        [ "$#" -gt 0 ] || die "$command needs an argument"
        local_graph update
        safe_run "$BIN_DIR/graphify" "$command" "$@" --graph "$GRAPH_JSON"
        ;;
    mcp)
        if [ "${1:-}" = --print-config ]; then
            require_setup
            "$VENV_PYTHON" - "$SCRIPT_DIR/graphify" <<'PY'
import json, sys
print(json.dumps({"mcpServers": {"graphify": {"command": "sh", "args": [sys.argv[1], "mcp"]}}}, indent=2))
PY
        else
            [ "$#" -eq 0 ] || die 'MCP supports stdio only'
            local_graph mcp
        fi
        ;;
    status)
        if [ -x "$VENV_PYTHON" ]; then
            safe_run "$BIN_DIR/graphify" --version
            local_graph check
        else
            printf 'graphify: navigation unavailable; run setup\n'
        fi
        ;;
    semantic)
        # Explicit opt-in only. Never downloads a model or modifies navigation.
        export GRAPHIFY_MODEL GRAPHIFY_TOKEN_BUDGET
        local_graph semantic "$@"
        ;;
    help | -h | --help)
        cat <<'EOF'
House Graphify: ignored local navigation and daily main Actions snapshots.

  setup [--no-hooks]  Install if missing, compose post-event hooks, refresh.
  update [--force]    Refresh atomically using local parsers only.
  check              Check local freshness; never a merge gate.
  query/explain/path/affected <args>  Refresh then query this checkout.
  mcp [--print-config]  Stdio navigation with freshness before each read.
  snapshot           Prepare graph.json and provenance.json for publication.
  semantic [--force]  Explicit local Ollama extraction in a separate ignored output.
  status             Show generator version and local freshness.

No automatic model download or tool upgrade. Exact installed versions key
fingerprints and provenance. Run an explicit uv tool upgrade in the shared
tool directory to upgrade, then update --force. See docs/graphify.md.
EOF
        ;;
    *) die "unknown command '$command'; run sh tools/graphify/graphify help" ;;
esac
