{
  // Orca quick commands and OpenChamber project actions for this repository
  // (house standard project-dev-surfaces). Both apps keep these in per-user
  // settings, so `node tools/dev/surfaces.mjs install` registers them; setup
  // runs it. An action runs a package script (`script`, through node --run)
  // or a `command`; `url` opens a page once it starts, and `primary` marks
  // OpenChamber's default action.
  // house:managed:begin - synced from Resnovas/.github templates/.agents/surfaces.jsonc. Edits inside this block are overwritten.
  "repository": "Resnovas/smartcloud",
  "agents": ["claude", "codex"],
  "house": [
    { "id": "setup", "label": "Setup", "script": "setup" },
    { "id": "check", "label": "Check: everything CI runs", "script": "check" },
    { "id": "test", "label": "Test", "script": "test" },
    { "id": "graph", "label": "Graph: open viewer", "command": "node tools/dev/open.mjs graphify-out/graph.html" },
    { "id": "graph-update", "label": "Graph: update", "command": "sh tools/graphify/graphify update" },
  ],
  // house:managed:end
  // house:local - add this repository's own actions to the list below.
  "actions": [],
}
