{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "SmartcloudConfig": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "$schema": {
          "type": "string"
        },
        "version": {
          "type": "number",
          "enum": [
            2
          ]
        },
        "extends": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExtendsEntry"
          }
        },
        "telemetry": {
          "type": "boolean",
          "description": "Set to false to stop smartcloud sending anonymous telemetry (hashed usage events, logs, traces, metrics and errors) to PostHog. On by default; turning it off is discouraged, because telemetry is how problems are found and fixed. The telemetry page of the documentation lists what is and is not collected."
        },
        "labels": {
          "type": "object",
          "required": [],
          "properties": {},
          "patternProperties": {
            "": {
              "$ref": "#/$defs/Label"
            }
          },
          "propertyNames": {
            "$ref": "#/$defs/RuleId"
          }
        },
        "labelSync": {
          "type": "object",
          "required": [],
          "properties": {
            "prune": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "labelling": {
          "type": "object",
          "required": [],
          "properties": {},
          "patternProperties": {
            "": {
              "$ref": "#/$defs/LabelRule"
            }
          },
          "propertyNames": {
            "$ref": "#/$defs/RuleId"
          }
        },
        "sizeLabels": {
          "$ref": "#/$defs/SizeLabels"
        },
        "conventions": {
          "$ref": "#/$defs/Conventions"
        },
        "roles": {
          "$ref": "#/$defs/Roles"
        },
        "links": {
          "$ref": "#/$defs/Links"
        },
        "commits": {
          "$ref": "#/$defs/Commits"
        },
        "disclosure": {
          "$ref": "#/$defs/Disclosure"
        },
        "reviews": {
          "$ref": "#/$defs/Reviews"
        },
        "required": {
          "$ref": "#/$defs/Required"
        },
        "stale": {
          "$ref": "#/$defs/Stale"
        },
        "settings": {
          "$ref": "#/$defs/Settings"
        },
        "sync": {
          "$ref": "#/$defs/Sync"
        }
      },
      "additionalProperties": false,
      "description": "Declarative repository automation: labels, conventions and policy.",
      "title": "smartcloud configuration"
    },
    "ExtendsEntry": {
      "type": "string",
      "description": "A preset to extend, as owner/repo/path@ref. The ref is optional.",
      "pattern": "^(?!\\.\\.?\\/)([A-Za-z0-9_.-]+)\\/(?!\\.\\.?\\/)([A-Za-z0-9_.-]+)\\/((?!\\.\\.?(?:\\/|@|$))[^/@]+(?:\\/(?!\\.\\.?(?:\\/|@|$))[^/@]+)*)(?:@([^@\\s]+))?$"
    },
    "Label": {
      "type": "object",
      "required": [
        "name",
        "color"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/Color"
        },
        "description": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Color": {
      "type": "string",
      "description": "Six hex digits, for example 0E8A16.",
      "pattern": "^#?[0-9a-fA-F]{6}$"
    },
    "RuleId": {
      "type": "string",
      "description": "A label or rule key.",
      "title": "nonEmptyString",
      "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
      "minLength": 1,
      "not": {
        "const": "__proto__"
      }
    },
    "LabelRule": {
      "type": "object",
      "required": [
        "label",
        "when"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/RuleId"
        },
        "on": {
          "$ref": "#/$defs/Subjects"
        },
        "when": {
          "$ref": "#/$defs/ConditionGroup"
        }
      },
      "additionalProperties": false
    },
    "Subjects": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "pullRequest",
          "issue"
        ]
      },
      "description": "The subjects a rule applies to. Omitted means pull requests and issues."
    },
    "ConditionGroup": {
      "type": "object",
      "required": [
        "condition"
      ],
      "properties": {
        "requires": {
          "$ref": "#/$defs/NonNegativeInt"
        },
        "condition": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          }
        }
      },
      "additionalProperties": false
    },
    "NonNegativeInt": {
      "type": "integer",
      "description": "an integer",
      "title": "int",
      "minimum": 0
    },
    "Condition": {
      "anyOf": [
        {
          "anyOf": [
            {
              "$ref": "#/$defs/titleMatches"
            },
            {
              "$ref": "#/$defs/descriptionMatches"
            },
            {
              "$ref": "#/$defs/creatorMatches"
            },
            {
              "$ref": "#/$defs/branchMatches"
            },
            {
              "$ref": "#/$defs/baseBranchMatches"
            },
            {
              "$ref": "#/$defs/isOpen"
            },
            {
              "$ref": "#/$defs/isLocked"
            },
            {
              "$ref": "#/$defs/isDraft"
            },
            {
              "$ref": "#/$defs/pendingReview"
            },
            {
              "$ref": "#/$defs/requestedChanges"
            },
            {
              "$ref": "#/$defs/commitsSignedOff"
            },
            {
              "$ref": "#/$defs/hasConflict"
            },
            {
              "$ref": "#/$defs/checksPass"
            },
            {
              "$ref": "#/$defs/checkStatus"
            },
            {
              "$ref": "#/$defs/hasLabel"
            },
            {
              "$ref": "#/$defs/isStale"
            },
            {
              "$ref": "#/$defs/isAbandoned"
            },
            {
              "$ref": "#/$defs/filesMatch"
            },
            {
              "$ref": "#/$defs/changesSize"
            },
            {
              "$ref": "#/$defs/isApproved"
            },
            {
              "$ref": "#/$defs/commitMessagesMatch"
            },
            {
              "$ref": "#/$defs/hasTrailer"
            }
          ]
        },
        {
          "$ref": "#/$defs/$and"
        },
        {
          "$ref": "#/$defs/$or"
        },
        {
          "$ref": "#/$defs/$not"
        },
        {
          "$ref": "#/$defs/$only"
        }
      ]
    },
    "titleMatches": {
      "type": "object",
      "required": [
        "type",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "titleMatches"
          ]
        },
        "condition": {
          "$ref": "#/$defs/Pattern"
        }
      },
      "additionalProperties": false,
      "description": "The title matches a pattern."
    },
    "Pattern": {
      "type": "string"
    },
    "descriptionMatches": {
      "type": "object",
      "required": [
        "type",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "descriptionMatches"
          ]
        },
        "condition": {
          "$ref": "#/$defs/Pattern"
        }
      },
      "additionalProperties": false,
      "description": "The description matches a pattern."
    },
    "creatorMatches": {
      "type": "object",
      "required": [
        "type",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "creatorMatches"
          ]
        },
        "condition": {
          "$ref": "#/$defs/Pattern"
        }
      },
      "additionalProperties": false,
      "description": "The author's login matches a pattern."
    },
    "branchMatches": {
      "type": "object",
      "required": [
        "type",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "branchMatches"
          ]
        },
        "condition": {
          "$ref": "#/$defs/Pattern"
        }
      },
      "additionalProperties": false,
      "description": "The pull request's head branch matches a pattern."
    },
    "baseBranchMatches": {
      "type": "object",
      "required": [
        "type",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "baseBranchMatches"
          ]
        },
        "condition": {
          "$ref": "#/$defs/Pattern"
        }
      },
      "additionalProperties": false,
      "description": "The pull request's base branch, the one it merges into, matches a pattern."
    },
    "isOpen": {
      "type": "object",
      "required": [
        "type",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "isOpen"
          ]
        },
        "condition": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "The subject is open, or closed when false."
    },
    "isLocked": {
      "type": "object",
      "required": [
        "type",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "isLocked"
          ]
        },
        "condition": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "The conversation is locked, or unlocked when false."
    },
    "isDraft": {
      "type": "object",
      "required": [
        "type",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "isDraft"
          ]
        },
        "condition": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "The pull request is a draft, or ready when false."
    },
    "pendingReview": {
      "type": "object",
      "required": [
        "type",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "pendingReview"
          ]
        },
        "condition": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "Requested reviewers have not reviewed yet."
    },
    "requestedChanges": {
      "type": "object",
      "required": [
        "type",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "requestedChanges"
          ]
        },
        "condition": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "A reviewer's latest review requests changes."
    },
    "commitsSignedOff": {
      "type": "object",
      "required": [
        "type",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "commitsSignedOff"
          ]
        },
        "condition": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "Every non-merge commit has a Signed-off-by trailer matching its author email."
    },
    "hasConflict": {
      "type": "object",
      "required": [
        "type",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "hasConflict"
          ]
        },
        "condition": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "The pull request conflicts with its base branch, or does not when false. Unknown mergeability counts as not conflicting."
    },
    "checksPass": {
      "type": "object",
      "required": [
        "type",
        "checks",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "checksPass"
          ]
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "description": "A check run name or commit status context, matched exactly.",
            "title": "nonEmptyString",
            "minLength": 1
          },
          "description": "Check run names or commit status contexts, matched exactly."
        },
        "condition": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "Every named check succeeded, or at least one has not when false. A check that has not reported yet has not succeeded."
    },
    "checkStatus": {
      "type": "object",
      "required": [
        "type",
        "check",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "checkStatus"
          ]
        },
        "check": {
          "type": "string",
          "description": "A check run name or commit status context, matched exactly.",
          "title": "nonEmptyString",
          "minLength": 1
        },
        "condition": {
          "type": "string",
          "enum": [
            "success",
            "failure",
            "pending"
          ],
          "description": "success, failure or pending; a check that has not reported yet is pending."
        }
      },
      "additionalProperties": false,
      "description": "The named check is in this state. A check that has not reported yet is pending."
    },
    "hasLabel": {
      "type": "object",
      "required": [
        "type",
        "label",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "hasLabel"
          ]
        },
        "label": {
          "type": "string"
        },
        "condition": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "The subject has the label, or lacks it when false."
    },
    "isStale": {
      "type": "object",
      "required": [
        "type",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "isStale"
          ]
        },
        "condition": {
          "type": "number",
          "description": "A number of days.",
          "title": "nonNegative",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "description": "No activity for at least this many days."
    },
    "isAbandoned": {
      "type": "object",
      "required": [
        "type",
        "condition",
        "label"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "isAbandoned"
          ]
        },
        "condition": {
          "type": "number",
          "description": "A number of days.",
          "title": "nonNegative",
          "minimum": 0
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Carries the stale label and has had no activity for at least this many days."
    },
    "filesMatch": {
      "type": "object",
      "required": [
        "type",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "filesMatch"
          ]
        },
        "condition": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "At least one changed file matches a glob."
    },
    "changesSize": {
      "type": "object",
      "required": [
        "type",
        "min"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "changesSize"
          ]
        },
        "min": {
          "$ref": "#/$defs/NonNegativeInt"
        },
        "max": {
          "$ref": "#/$defs/NonNegativeInt"
        }
      },
      "additionalProperties": false,
      "description": "Lines added plus deleted are at least min and below max."
    },
    "isApproved": {
      "type": "object",
      "required": [
        "type",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "isApproved"
          ]
        },
        "condition": {
          "$ref": "#/$defs/NonNegativeInt"
        },
        "allowPending": {
          "type": "boolean",
          "description": "Count approvals while other requested reviewers are still pending (default false)."
        }
      },
      "additionalProperties": false,
      "description": "No reviewer is requesting changes, at least this many approved, and none are pending unless allowPending is set."
    },
    "commitMessagesMatch": {
      "type": "object",
      "required": [
        "type",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "commitMessagesMatch"
          ]
        },
        "condition": {
          "$ref": "#/$defs/Pattern"
        },
        "scope": {
          "type": "string",
          "enum": [
            "all",
            "any"
          ],
          "description": "Whether every commit (all) or at least one commit (any) must match."
        }
      },
      "additionalProperties": false,
      "description": "Commit messages match a pattern."
    },
    "hasTrailer": {
      "type": "object",
      "required": [
        "type",
        "trailer"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "hasTrailer"
          ]
        },
        "trailer": {
          "type": "string"
        },
        "condition": {
          "$ref": "#/$defs/Pattern"
        },
        "scope": {
          "type": "string",
          "enum": [
            "all",
            "any"
          ],
          "description": "Whether every commit (all) or at least one commit (any) must match."
        }
      },
      "additionalProperties": false,
      "description": "Commits carry the trailer, with a value matching the pattern when one is given."
    },
    "$and": {
      "type": "object",
      "required": [
        "type",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "$and"
          ]
        },
        "condition": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConditionGroup"
          }
        }
      },
      "additionalProperties": false,
      "description": "Every group passes."
    },
    "$or": {
      "type": "object",
      "required": [
        "type",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "$or"
          ]
        },
        "condition": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConditionGroup"
          }
        }
      },
      "additionalProperties": false,
      "description": "At least one group passes."
    },
    "$not": {
      "type": "object",
      "required": [
        "type",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "$not"
          ]
        },
        "requires": {
          "$ref": "#/$defs/NonNegativeInt"
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConditionGroup"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": [
                {
                  "$ref": "#/$defs/ConditionGroup"
                }
              ],
              "additionalItems": false
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              }
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "The group fails."
    },
    "$only": {
      "type": "object",
      "required": [
        "type",
        "requires",
        "condition"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "$only"
          ]
        },
        "requires": {
          "$ref": "#/$defs/NonNegativeInt"
        },
        "condition": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ConditionGroup"
          }
        }
      },
      "additionalProperties": false,
      "description": "Exactly this many of the groups pass."
    },
    "SizeLabels": {
      "type": "object",
      "required": [],
      "properties": {
        "thresholds": {
          "type": "object",
          "required": [],
          "properties": {
            "s": {
              "$ref": "#/$defs/Int",
              "description": "The fewest lines added plus deleted that make a pull request Size: S. Defaults to 10.",
              "title": "positive",
              "exclusiveMinimum": 0
            },
            "m": {
              "$ref": "#/$defs/Int",
              "description": "The fewest lines added plus deleted that make a pull request Size: M. Defaults to 100.",
              "title": "positive",
              "exclusiveMinimum": 0
            },
            "l": {
              "$ref": "#/$defs/Int",
              "description": "The fewest lines added plus deleted that make a pull request Size: L. Defaults to 500.",
              "title": "positive",
              "exclusiveMinimum": 0
            },
            "xl": {
              "$ref": "#/$defs/Int",
              "description": "The fewest lines added plus deleted that make a pull request Size: XL. Defaults to 1000.",
              "title": "positive",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false,
          "description": "The first line count of each size above XS. Sizes left out keep their defaults; the thresholds must rise from s to xl."
        }
      },
      "additionalProperties": false,
      "description": "Built-in Size: XS to Size: XL labels, applied to pull requests by lines added plus deleted. Thresholds are the first line count of each size."
    },
    "Int": {
      "type": "integer",
      "description": "an integer",
      "title": "int"
    },
    "Conventions": {
      "type": "object",
      "required": [],
      "properties": {
        "comment": {
          "type": "object",
          "required": [],
          "properties": {
            "header": {
              "type": "string"
            },
            "footer": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "rules": {
          "type": "object",
          "required": [],
          "properties": {},
          "patternProperties": {
            "": {
              "$ref": "#/$defs/ConventionRule"
            }
          },
          "propertyNames": {
            "$ref": "#/$defs/RuleId"
          }
        }
      },
      "additionalProperties": false
    },
    "ConventionRule": {
      "type": "object",
      "required": [],
      "properties": {
        "on": {
          "$ref": "#/$defs/Subjects"
        },
        "level": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ]
        },
        "message": {
          "type": "string"
        },
        "preset": {
          "type": "string",
          "enum": [
            "conventionalCommits",
            "semanticTitle",
            "gitmojis",
            "semanticEmoji"
          ]
        },
        "contexts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "when": {
          "$ref": "#/$defs/ConditionGroup"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "preset"
              ]
            },
            {
              "required": [
                "when"
              ]
            }
          ]
        }
      ]
    },
    "Roles": {
      "type": "object",
      "required": [],
      "properties": {
        "maintainers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
