{
  "name": "smartcloud",
  "firstRelease": "2.0.0",
  "majorTag": true,
  "bundles": [
    {
      "target": "@resnovas/action:bundle",
      "output": "dist/index.js",
      "project": "@resnovas/action"
    }
  ],
  "dropFromReleaseCommit": [
    "externals"
  ],
  "apps": [
    "apps/action",
    "apps/cli",
    "apps/mcp"
  ],
  "nightly": {
    "major": 2
  },
  "posthog": {
