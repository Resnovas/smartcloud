    "bundleTargets": [
      "@resnovas/smartcloud:bundle",
      "@resnovas/smartcloud-mcp:bundle"
    ],
    "sbomProjects": [
      "@resnovas/smartcloud",
      "@resnovas/smartcloud-mcp"
    ]
  },
  "versionGlobal": "__SMARTCLOUD_VERSION__"
